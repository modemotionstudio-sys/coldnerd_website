{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy-policy", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/privacy", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/terms", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/blog/instagram-cold-outreach-guide", "destination": "/blog/instagram-cold-outreach-the-complete-guide", "permanent": true },
    { "source": "/blog/blog-:slug", "destination": "/blog/:slug", "permanent": true },
    {
      "source": "/blog",
      "has": [{ "type": "query", "key": "highlight", "value": "(?<slug>[a-z0-9-]+)" }],
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/app" },
    { "source": "/admin", "destination": "/app" },
    { "source": "/admin/:path*", "destination": "/app" }
  ]
}
